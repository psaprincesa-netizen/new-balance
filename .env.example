# Copie a URL REAL para as variáveis de ambiente na Vercel, nunca para o Git.
# PostgreSQL gerenciado (Neon/Supabase/etc.), de preferência endpoint pooler.
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=verify-full
# Não configure DATABASE_URL para usar SQLite localmente.
COOKIE_SECURE=1
